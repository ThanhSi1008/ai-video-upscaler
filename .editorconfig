# EditorConfig for AI Video Upscaler & Subtrans (Windows 11 + Multi-Agent)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

[*.{yaml,yml,json,jsonc,toml,ini}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false
