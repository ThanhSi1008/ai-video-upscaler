{
  "upscaler-session-context": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python hooks/session_start.py",
        "timeout": 5
      }
    ]
  },
  "upscaler-pre-tool-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|write_file|edit_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pre_tool_guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "upscaler-post-tool-lint": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/post_tool_lint.py",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "upscaler-stop-audit": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/stop_audit.py",
        "timeout": 2
      }
    ]
  }
}
